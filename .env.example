# ==========================================
# CityOS — Environment Configuration Example
# Copy this file to .env and fill real values.
# NEVER commit the actual .env file.
# ==========================================

NODE_ENV=development

# ---------- Backend ----------
BACKEND_PORT=4000
API_BASE_PATH=/api/v1
CORS_ORIGIN=http://localhost:5173

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
VITE_MAP_TILE_URL=https://demotiles.maplibre.org/style.json

# ---------- MongoDB ----------
MONGODB_URI=mongodb://localhost:27017/cityos

# ---------- JWT / Auth ----------
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- MinIO / Storage ----------
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=change_me
STORAGE_SECRET_KEY=change_me
STORAGE_BUCKET=cityos-media
STORAGE_USE_SSL=false

# ---------- AI Service ----------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=change_me
