# ==========================================
# CityOS — Environment Configuration Example
# Copy this file to .env and fill real values.
# NEVER commit the actual .env file.
# ==========================================

NODE_ENV=development

# ---------- Backend ----------
BACKEND_PORT=4000
API_BASE_PATH=/api/v1

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
VITE_MAP_TILE_URL=https://demotiles.maplibre.org/style.json

# ---------- PostgreSQL + PostGIS (Phase 2) ----------
DATABASE_URL=postgresql://cityos_user:cityos_password@localhost:5432/cityos_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cityos_db
DB_USER=cityos_user
DB_PASSWORD=change_me

# ---------- JWT / Auth (Phase 3) ----------
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---------- Redis (Phase 8) ----------
REDIS_URL=redis://localhost:6379

# ---------- MinIO / Storage (later) ----------
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=change_me
STORAGE_SECRET_KEY=change_me
STORAGE_BUCKET=cityos-media
STORAGE_USE_SSL=false

# ---------- AI Service (Phase 7) ----------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=change_me

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:5173